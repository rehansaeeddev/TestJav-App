APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopify app credentials from the Dev Dashboard. Never commit or share the secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# Origins allowed to call this API from the browser (your React Router app), comma-separated.
# Patterns allow changing tunnel URLs. Keep the single quotes: a value starting with # is a comment.
FRONTEND_ORIGINS=
FRONTEND_ORIGIN_PATTERNS='#^https://[a-z0-9-]+\.trycloudflare\.com$#'

# Chat model that writes replies (OpenAI-compatible API). Never commit real values.
# Prototype, local Ollama: URL below, key empty.
# Later, OpenRouter: CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions, CHAT_API_KEY=<key>
CHAT_API_URL=http://127.0.0.1:11434/v1/chat/completions
CHAT_API_KEY=
CHAT_MODEL=qwen3.5:2b
# "none" turns off hidden thinking (needed for qwen3.5 on Ollama). Leave empty for OpenRouter.
CHAT_REASONING_EFFORT=none
CHAT_TIMEOUT=60

# Meaning-based guide search (RAG). Local Ollama model; run `php artisan guides:embed` after seeding guides.
EMBEDDING_API_URL=http://127.0.0.1:11434/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text

# Decision engine (Jev /v1/systemone protocol).
# Prototype, local Laya: DECISION_API_URL=http://127.0.0.1:8001/v1/systemone, DECISION_MODEL=english
# Later, paid Jev: DECISION_API_URL=https://openrouter.ai/api/v1/systemone,
#                  DECISION_API_KEY=<OpenRouter key>, DECISION_MODEL=typesafe/jev-1.14
DECISION_API_URL=http://127.0.0.1:8001/v1/systemone
DECISION_API_KEY=
DECISION_MODEL=english
DECISION_TIMEOUT=5
